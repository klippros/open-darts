{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-darts-match-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH",
        "class_name": "MatchObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchObject"],
    },
  ],
}
